logging:
  level: info  # valid levels: error, warning, info, debug
  output-paths:
    - stdout
    - logs/{{ .service }}-stdout.log
provisioning:
  listen-addr: 0.0.0.0:${PROVISIONING_PORT}
  protocol: https
  cert: /opt/veraison/provisioning.crt
  cert-key: /opt/veraison/provisioning.key
  max-payload-size: 1MB
verification:
  listen-addr: 0.0.0.0:${VERIFICATION_PORT}
  protocol: https
  cert: /opt/veraison/verification.crt
  cert-key: /opt/veraison/verification.key
  max-payload-size: 1MB
management:
  listen-addr: 0.0.0.0:${MANAGEMENT_PORT}
  protocol: https
  cert: /opt/veraison/management.crt
  cert-key: /opt/veraison/management.key
  max-payload-size: 1MB
coserv:
  listen-addr: 0.0.0.0:${COSERV_PORT}
  protocol: https
  cert: /opt/veraison/coserv.crt
  cert-key: /opt/veraison/coserv.key
vts:
  server-addr: vts-service:${VTS_PORT}
  tls: true
  cert: /opt/veraison/vts.crt
  cert-key: /opt/veraison/vts.key
  corim-ca-certs:
    - /opt/veraison/corimCA.crt
ear-signer:
  alg: ES256
  key: skey.jwk
plugin:
  backend: go-plugin
  go-plugin-schemes:
    dir: ./plugins/schemes/
  go-plugin-stores:
    dir: ./plugins/stores/
po-store:
  backend: sql
  sql:
    max_connections: 10
    driver: sqlite3
    datasource: stores/vts/po-store.sql
po-agent:
    backend: opa
endorsement-store:
  coserv:
    max-expiry: 5 mins
    signer:
      alg: ES256
      key: /opt/veraison/coserv-signer.jwk
  active-plugins:
    - corim-store
    # - cca-coserv-broker
    - nvidia-coserv-proxy-handler
    - amd-kds-coserv-proxy-handler
  plugin-parameters:
    corim-store:
      dbms: sqlite
      dsn: /opt/veraison/stores/vts/store.sql
    cca-coserv-broker:
    # Config for Remote Coserv Service
    # enable-broker ==> "Enable endorsement broker to call remote coserv service"
    # coserv-url ==> "Remote coserv service URL which follows draft-ietf-rats-coserv-06 IETF draft"
    # client-tls-insecure ==> "Enable insecure TLS, no certificate validation"
    # client-certs ==> "If secure TLS, certs to verify with, each path (inside docker container) separated by comma"
    # client-caching ==> "Enable caching for coserv fetch"
    # unsigned-coserv ==> "If true then only accepts unsigned coserv as reponse from remote service"
      enable-broker: false
      coserv-url: "https://veraison.test.linaro.org:11443"
      client-tls-insecure: true
      client-certs: ""
      client-caching: true
      unsigned-coserv: false
auth:
  backend: keycloak
  host: keycloak-service
  port: ${KEYCLOAK_PORT}
