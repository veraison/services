logging:
  level: info  # valid levels: error, warning, info, debug
  output-paths:
    - stdout
    - logs/{{ .service }}-stdout.log
provisioning:
  listen-addr: 0.0.0.0:${PROVISIONING_PORT}
  protocol: https
  cert: /opt/veraison/provisioning.crt
  cert-key: /opt/veraison/provisioning.key
  max-payload-size: 1MB
verification:
  listen-addr: 0.0.0.0:${VERIFICATION_PORT}
  protocol: https
  cert: /opt/veraison/verification.crt
  cert-key: /opt/veraison/verification.key
  max-payload-size: 1MB
management:
  listen-addr: 0.0.0.0:${MANAGEMENT_PORT}
  protocol: https
  cert: /opt/veraison/management.crt
  cert-key: /opt/veraison/management.key
  max-payload-size: 1MB
coserv:
  listen-addr: 0.0.0.0:${COSERV_PORT}
  protocol: https
  cert: /opt/veraison/coserv.crt
  cert-key: /opt/veraison/coserv.key
vts:
  server-addr: vts-service:${VTS_PORT}
  tls: true
  cert: /opt/veraison/vts.crt
  cert-key: /opt/veraison/vts.key
  corim-ca-certs:
    - /opt/veraison/corimCA.crt
ear-signer:
  alg: ES256
  key: skey.jwk
plugin:
  backend: go-plugin
  go-plugin-schemes:
    dir: ./plugins/schemes/
  go-plugin-stores:
    dir: ./plugins/stores/
po-store:
  backend: sql
  sql:
    max_connections: 10
    driver: sqlite3
    datasource: stores/vts/po-store.sql
po-agent:
    backend: opa
endorsement-store:
  coserv:
    max-expiry: 5 mins
    signer:
      alg: ES256
      key: /opt/veraison/coserv-signer.jwk
  active-plugins:
    - corim-store
    # - coserv-broker
    - nvidia-coserv-proxy-handler
    - amd-kds-coserv-proxy-handler
  plugin-parameters:
    corim-store:
      dbms: sqlite
      dsn: /opt/veraison/stores/vts/store.sql
    coserv-broker:
      enable-broker: false
      client-caching: true
      # CoSERV configurations of schemes
      schemes:
        ARM_CCA:
          coserv-url: "https://veraison.test.linaro.org:11443"
          client-tls-insecure: true
          client-certs:
            - ""
          unsigned-coserv: false
          profile: "tag:arm.com,2025:cca_platform#1.0.0"
auth:
  backend: keycloak
  host: keycloak-service
  port: ${KEYCLOAK_PORT}
