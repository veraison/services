# Management service container.
# The context for building this image is assumed to be the Veraison deployment
# directory (/tmp/veraison is the default for make build).
# NVAT packages are currently published for Ubuntu, rather than Debian Trixie,
# hence the base image here differs from the other services. The NVIDIA GPU
# scheme plugin dlopen()s libnvat.so.1 at runtime; without it the plugin fails
# to load with "libnvat.so.1: cannot open shared object file" and NVIDIA GPU
# evidence cannot be appraised. libnvat is not published for debian13.
FROM ubuntu:24.04 AS veraison-management

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install \
        --assume-yes \
        --no-install-recommends \
	uuid-runtime \
	ca-certificates \
	wget \
    && distro="$(. /etc/os-release && printf '%s%s' "$ID" "$(printf '%s' "$VERSION_ID" | tr -d .)")" \
    && case "$(dpkg --print-architecture)" in \
           amd64) repo_arch=x86_64 ;; \
           arm64) repo_arch=sbsa ;; \
           *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && wget --quiet "https://developer.download.nvidia.com/compute/cuda/repos/${distro}/${repo_arch}/cuda-keyring_1.1-1_all.deb" \
    && dpkg --install cuda-keyring_1.1-1_all.deb \
    && rm -f cuda-keyring_1.1-1_all.deb \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --assume-yes --no-install-recommends libnvat \
    && DEBIAN_FRONTEND=noninteractive apt-get purge --assume-yes wget \
    && uuidgen | tr -d - > /etc/machine-id \
    && apt-get clean \
    && apt-get autoremove --assume-yes \
    && rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/*

RUN groupadd -g 616 veraison && \
    useradd -m  -g veraison  --system veraison

ADD --chown=root:root certs/rootCA.crt /usr/local/share/ca-certificates/veraison-ca.crt
ADD --chown=root:root certs/corimCA.crt /usr/local/share/ca-certificates/corim-ca.crt
RUN update-ca-certificates

USER veraison

WORKDIR /opt/veraison

ADD --chown=veraison:nogroup plugins plugins
ADD --chown=veraison:nogroup config.yaml management-service service-entrypoint \
    certs/management.crt certs/management.key ./

ENTRYPOINT ["/opt/veraison/service-entrypoint"]
CMD ["/opt/veraison/management-service"]

