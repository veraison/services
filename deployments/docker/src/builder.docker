# Go version that will be used to build the project. Due to dependencies, it
# must be at least 1.26.
ARG GO_VERSION=1.26

FROM golang:${GO_VERSION}-bookworm AS go-toolchain

# NVAT packages are currently published for Ubuntu, rather than Debian Trixie.
FROM ubuntu:24.04 AS veraison-builder

COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:${PATH}

# User identity that will be used to build the project. This should be
# overriden at build time to match the host user running the builder, who owns
# the git checkout of the source.
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install \
        --assume-yes \
        --no-install-recommends \
	build-essential \
	git \
        protobuf-compiler \
        libprotobuf-dev \
        sqlite3 \
	uuid-runtime \
	gettext-base \
        vim \
        jq \
        iputils-ping \
        nmap \
        sudo \
	ca-certificates \
        wget \
    && distro="$(. /etc/os-release && printf '%s%s' "$ID" "$(printf '%s' "$VERSION_ID" | tr -d .)")" \
    && case "$(dpkg --print-architecture)" in \
           amd64) repo_arch=x86_64 ;; \
           arm64) repo_arch=sbsa ;; \
           *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
       esac \
    && wget --quiet "https://developer.download.nvidia.com/compute/cuda/repos/${distro}/${repo_arch}/cuda-keyring_1.1-1_all.deb" \
    && dpkg --install cuda-keyring_1.1-1_all.deb \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --assume-yes --no-install-recommends libnvat-dev \
    && uuidgen | tr -d - > /etc/machine-id \
    && apt-get clean \
    && apt-get autoremove --assume-yes \
    && rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/*

SHELL ["/bin/bash", "-c"]

# Builder password is "builder" (sans quotes).
RUN userdel -f $(cat /etc/passwd | awk -F: "\$3 == ${BUILDER_UID}" | cut -d: -f1); \
    groupdel -f $(cat /etc/group | awk -F: "\$3 == ${BUILDER_GID}" | cut -d: -f1); \
    groupadd -g ${BUILDER_GID} builder && \
    groupadd -g 616 veraison && \
    useradd -m -u ${BUILDER_UID} -g builder -G sudo,veraison \
    -p paxyJoB0NZsNU -s /bin/bash builder

ADD --chown=root:root rootCA.crt /usr/local/share/ca-certificates/veraison-ca.crt
RUN update-ca-certificates

WORKDIR /veraison

RUN chown builder:builder /veraison

USER builder

RUN mkdir --mode=775 logs stores build
ADD --chown=builder:builder go.mod go.sum ./

# Download Go modules
RUN go mod download &&\
    go install golang.org/x/tools/gopls@v0.21.1 &&\
    go install golang.org/x/tools/cmd/guru@latest &&\
    go install github.com/golang/mock/mockgen@v1.7.0-rc.1 &&\
    go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.26 &&\
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.1 &&\
    go install github.com/mitchellh/protoc-gen-go-json@v1.1.0 &&\
    go install github.com/veraison/cocli@7ee92696 &&\
    go install github.com/veraison/evcli/v2@1685bf5 &&\
    go install github.com/veraison/pocli@v0.2.0 &&\
    go install github.com/go-delve/delve/cmd/dlv@v1.26.0 &&\
    go install github.com/veraison/corim-store/cmd/corim-store@818cd5f652ce

ADD --chown=builder:builder builder-dispatcher .
ADD --chown=builder:builder builder-bashrc /home/builder/.bashrc


ENTRYPOINT ["/veraison/builder-dispatcher"]
CMD ["help"]
