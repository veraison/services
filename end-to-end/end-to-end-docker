# remove the leading "+" from "set -x" output
PS4=""

SCHEME=${SCHEME:-psa}

TEMP_DIR=/tmp/veraison-end-to-end
THIS_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
VERAISON="$THIS_DIR/../deployments/docker/veraison"

source "$THIS_DIR/../deployments/docker/env.bash"

function provision() {
    local corim_files=()
    local media_types=()

    case $SCHEME  in
        psa)
            corim_files+=("$THIS_DIR/input/psa-endorsements.cbor")
            media_types+=("application/rim+cbor; profile=\"tag:arm.com,2025:psa#1.0.0\"")
            ;;
        cca)
            corim_files+=("$THIS_DIR/input/cca-endorsements.cbor")
            media_types+=("application/rim+cbor; profile=\"tag:arm.com,2025:cca_platform#1.0.0\"")
            corim_files+=("$THIS_DIR/input/cca-realm-endorsements.cbor")
            media_types+=("application/rim+cbor; profile=\"tag:arm.com,2025:cca_realm#1.0.0\"")
            ;;
        *)
            echo "ERROR: bad SCHEME: $SCHEME"
            exit 1
            ;;
    esac

    for  i in "${!corim_files[@]}"; do
        set -x

        $VERAISON -- cocli corim submit --corim-file "${corim_files[i]}" --media-type "${media_types[i]}"

        { set +x; } 2>/dev/null
    done
}

function check() {
    $VERAISON stores
}

function check_ear() {

    # When SCHEME is cca the realm ear.status would be "warning",
    # but the plaform one should be "affirming".
    if $VERAISON -- arc print ${TEMP_DIR}/ear.jwt | grep -q '"ear.status": "affirming"'; then
        echo "Successfull attestation"
    else
        echo "Attestaion failed:"
        $VERAISON -- arc print ${TEMP_DIR}/ear.jwt
        exit 1
    fi
}

function verify_as_attester() {
    case $SCHEME  in
        psa)
            local claims="$THIS_DIR/input/psa-claims-profile-2-without-nonce.json"
            local -a key_args=(--key "$THIS_DIR/input/ec-p256.jwk")
            local -a nonce_args=(--nonce-size=32)
            ;;
        cca)
            local claims="$THIS_DIR/input/cca-claims-without-realm-challenge.json"
            local -a key_args=(--iak "$THIS_DIR/input/cca-platform-key.json" --rak "$THIS_DIR/input/cca-realm-key.json")
            local -a nonce_args=()
            ;;
        *)
            echo "ERROR: bad SCHEME: $SCHEME"
            exit 1
            ;;
    esac

    $VERAISON -- evcli "$SCHEME" verify-as attester --claims "$claims"  "${key_args[@]}" "${nonce_args[@]}" \
        | grep -v "Using config file" | tr -d '"' >${TEMP_DIR}/ear.jwt

    check_ear
}

function verify_as_relying_party() {
    case $SCHEME  in
        psa)
            local token="$THIS_DIR/input/psa-evidence.cbor"
            ;;
        cca)
            local token="$THIS_DIR/input/cca-evidence.cbor"
            ;;
        *)
            echo "ERROR: bad SCHEME: $SCHEME"
            exit 1
            ;;
    esac

    $VERAISON -- evcli "$SCHEME" verify-as relying-party --token "$token" \
        | grep -v "Using config file" | tr -d '"' >${TEMP_DIR}/ear.jwt

    check_ear
}

function verify() {
    as=$1

    mkdir -p ${TEMP_DIR}
    case $as in
        attester | attest) verify_as_attester;;
        rp | relying-party) verify_as_relying_party;;
        *) echo "ERROR unexected \"as\": \"$as\"; should be either \"attester\" or \"rp\""
    esac
}


function help() {
cat <<'EOF'
Usage: ./end-to-end-docker [command]

Command:

  provision
      Provision endorsements and trust anchors via the provisioning API.
  check | check-stores
      Check the contents of the endorsement and trust anchor stores.
  verify [ attester | rp ]
      Verify claims via verification API either as an attester or the relying party.

EOF
}

function _check_scheme() {
    case $SCHEME in
        psa | cca)
            ;;
        *)
            echo "ERROR: unknown SCHEME: '$SCHEME'; must be 'cca' or 'psa'"; exit 1
            ;;
    esac
}

# shellcheck disable=2046
set -- $(getopt "hs:" "$@")
while [ -n "$1" ]
do
  case "$1" in
    -h) help; exit;;
    -s) SCHEME=$2; shift;;
     *) break;;
  esac

  shift
done
shift

_check_scheme

command=$1
case $command in
    help) help;;
    provision) provision;;
    check | check-stores) check;;
    verify) verify "$2";;
    *) echo "ERROR: unexpected command: \"$command\""; help;;
esac
